+/* The console's kernel and its video chip. */
+extern int sceKernelAllocateDirectMemory(int64_t searchStart, int64_t searchEnd, size_t len,
+                                          size_t alignment, int type, int64_t* start);
+extern int sceKernelMapDirectMemory(void** addr, size_t len, int prot, int flags, int64_t start,
+                                     size_t alignment);
+extern int sceKernelReleaseDirectMemory(int64_t start, size_t len);
+extern int64_t sceKernelGetDirectMemorySize(void);
+extern int sceKernelMapFlexibleMemory(void** addr, size_t len, int prot, int flags);
+extern int sceKernelMapNamedFlexibleMemory(void** addr, size_t len, int prot, int flags,
+                                           const char* name);
+extern int sceKernelMunmap(void* addr, size_t len);
+
+extern int sceVideodec2QueryComputeMemoryInfo(void* info);
+extern int sceVideodec2AllocateComputeQueue(const void* config, const void* memory, void** queue);
+extern int sceVideodec2QueryDecoderMemoryInfo(const void* config, void* memory);
+extern int sceVideodec2CreateDecoder(const void* config, const void* memory, void** decoder);
+extern int sceVideodec2DeleteDecoder(void* decoder);
+extern int sceVideodec2Decode(void* decoder, const void* input, void* frame, void* output);
+extern int sceVideodec2Flush(void* decoder, void* frame, void* output);
+extern int sceVideodec2Reset(void* decoder);
+
+/* The chip's structures. Their sizes are fixed by the console. */
+enum
+{
+    VDEC_CODEC_AVC  = 1,
+    VDEC_CODEC_HEVC = 974921,
+};
+
+typedef struct VdecConfig
+{
+    uint64_t this_size;
+    uint32_t resource_type;  // 1: decoding on a compute queue
+    uint32_t codec_type;
+    uint32_t profile;
+    uint32_t max_level;
+    int32_t max_frame_width;
+    int32_t max_frame_height;
+    int32_t max_dpb_frame_count;
+    uint32_t decode_pipeline_depth;
+    void* compute_queue;
+    uint64_t cpu_affinity_mask;
+    int32_t cpu_thread_priority;
+    bool optimize_progressive_video;
+    bool check_memory_type;
+    uint8_t reserved0;
+    uint8_t reserved1;
+    void* extra_config_info;
+} VdecConfig;
+
+typedef struct VdecMemory
+{
+    uint64_t this_size;
+    uint64_t cpu_memory_size;
+    void* cpu_memory;
+    uint64_t gpu_memory_size;
+    void* gpu_memory;
+    uint64_t cpu_gpu_memory_size;
+    void* cpu_gpu_memory;
+    uint64_t max_frame_buffer_size;
+    uint32_t frame_buffer_alignment;
+    uint32_t reserved0;
+} VdecMemory;
+
+typedef struct VdecInput
+{
+    uint64_t this_size;
+    void* au_data;
+    uint64_t au_size;
+    uint64_t pts_data;
+    uint64_t dts_data;
+    uint64_t attached_data;
+} VdecInput;
+
+typedef struct VdecOutput
+{
+    uint64_t this_size;
+    bool is_valid;
+    bool is_error_frame;
+    uint8_t picture_count;
+    uint8_t padding;
+    uint32_t codec_type;
+    uint32_t frame_width;
+    uint32_t frame_pitch;  // in samples
+    uint32_t frame_height;
+    uint32_t reserved;
+    void* frame_buffer;
+    uint64_t frame_buffer_size;
+    uint32_t frame_format;
+    uint32_t frame_pitch_in_bytes;
+} VdecOutput;
+
+typedef struct VdecFrameBuffer
+{
+    uint64_t this_size;
+    void* frame_buffer;
+    uint64_t frame_buffer_size;
+    bool is_accepted;
+} VdecFrameBuffer;
+
+typedef struct VdecComputeMemory
+{
+    uint64_t this_size;
+    uint64_t cpu_gpu_memory_size;
+    void* cpu_gpu_memory;
+} VdecComputeMemory;
+
+typedef struct VdecComputeConfig
+{
+    uint64_t this_size;
+    uint16_t compute_pipe_id;
+    uint16_t compute_queue_id;
+    bool check_memory_type;
+    uint8_t reserved0;
+    uint16_t reserved1;
+} VdecComputeConfig;
+
+#if defined(__GNUC__) || defined(__clang__)
+#define PS5_STATIC_ASSERT(cond, name) _Static_assert(cond, name)
+#else
+#define PS5_STATIC_ASSERT(cond, name)
+#endif
+
+PS5_STATIC_ASSERT(sizeof(VdecConfig) == 0x48, "decoder config");
+PS5_STATIC_ASSERT(sizeof(VdecMemory) == 0x48, "decoder memory");
+PS5_STATIC_ASSERT(sizeof(VdecInput) == 0x30, "input");
+PS5_STATIC_ASSERT(sizeof(VdecOutput) == 0x38, "output");
+PS5_STATIC_ASSERT(offsetof(VdecOutput, frame_buffer) == 0x20, "output frame buffer");
+PS5_STATIC_ASSERT(offsetof(VdecOutput, frame_pitch_in_bytes) == 0x34, "output pitch");
+PS5_STATIC_ASSERT(sizeof(VdecFrameBuffer) == 0x20, "frame buffer");
+PS5_STATIC_ASSERT(sizeof(VdecComputeMemory) == 0x18, "compute memory");
+PS5_STATIC_ASSERT(sizeof(VdecComputeConfig) == 0x10, "compute config");
+
+enum
+{
+    PROT_CPU_RW  = 0x03,
+    PROT_CPU_W   = 0x02,
+    PROT_GPU_RW  = 0x30,
+    // The chip checks the protection of the memory it is given: its own
+    // workspaces and the pools the access units and the pictures live in are
+    // written by the console and read by the chip.
+    PROT_CHIP_POOL = PROT_CPU_W | PROT_GPU_RW,
+    DIRECT_TYPE   = 12,
+};
+
+static const size_t PAGE_16K     = 0x4000;
+static const int    AU_SLOTS     = 8;
+static const size_t AU_SLOT_SIZE = (size_t)4 << 20;
+
+/**
+ * The chip aborts the process when it refuses work. The decoder has to
+ * survive that: the signal is caught and the work is given up.
+ */
+static sigjmp_buf g_abortJump;
+static volatile sig_atomic_t g_abortArmed = 0;
+static struct sigaction g_oldAbort;
+static struct sigaction g_oldSegv;
+
+static void abortHandler(int number, siginfo_t* info, void* context)
+{
+    if (g_abortArmed) {
+        g_abortArmed = 0;
+        siglongjmp(g_abortJump, number);
+    }
+    struct sigaction* previous = number == SIGABRT ? &g_oldAbort : &g_oldSegv;
+    if (previous->sa_flags & SA_SIGINFO)
+        previous->sa_sigaction(number, info, context);
+    else if (previous->sa_handler != SIG_DFL && previous->sa_handler != SIG_IGN)
+        previous->sa_handler(number);
+    else {
+        signal(number, SIG_DFL);
+        raise(number);
+    }
+}
+
+/**
+ * Runs the work with the chip's abort caught. Returns 0 when the work was
+ * given up.
+ */
+#define PS5_RUN_GUARDED(work, result)                                                  \
+    do {                                                                                \
+        struct sigaction action;                                                        \
+        memset(&action, 0, sizeof(action));                                             \
+        action.sa_sigaction = abortHandler;                                             \
+        action.sa_flags     = SA_SIGINFO;                                               \
+        sigaction(SIGABRT, &action, &g_oldAbort);                                        \
+        sigaction(SIGSEGV, &action, &g_oldSegv);                                        \
+        g_abortArmed = 1;                                                               \
+        if (sigsetjmp(g_abortJump, 1) == 0) {                                           \
+            work;                                                                       \
+        } else {                                                                        \
+            result = AVERROR_EXTERNAL;                                                  \
+        }                                                                               \
+        g_abortArmed = 0;                                                               \
+        sigaction(SIGABRT, &g_oldAbort, NULL);                                          \
+        sigaction(SIGSEGV, &g_oldSegv, NULL);                                           \
+    } while (0)
+
+static size_t round16k(size_t value)
+{
+    return (value + PAGE_16K - 1) & ~(PAGE_16K - 1);
+}
+
+/**
+ * A block of memory the chip can read. The chip's picture store and its
+ * access units live in the graphics memory; its working memory can be plain
+ * system memory.
+ */
+typedef struct Mem
+{
+    void* addr;
+    size_t len;
+    int64_t start;  // direct memory; -1: flexible; -2: the shared cpu block
+} Mem;
+
+static int memDirect(Mem* mem, size_t len, size_t alignment, int prot)
+{
+    mem->len   = round16k(len);
+    mem->start = -1;
+    mem->addr  = NULL;
+    if (alignment < PAGE_16K)
+        alignment = PAGE_16K;
+    if (sceKernelAllocateDirectMemory(0, sceKernelGetDirectMemorySize(), mem->len, alignment,
+                                      DIRECT_TYPE, &mem->start) != 0)
+        return AVERROR(ENOMEM);
+    if (sceKernelMapDirectMemory(&mem->addr, mem->len, prot, 0, mem->start, alignment) != 0) {
+        sceKernelReleaseDirectMemory(mem->start, mem->len);
+        mem->start = -1;
+        mem->addr  = NULL;
+        return AVERROR(ENOMEM);
+    }
+    return 0;
+}
+
+static int memFlexible(Mem* mem, size_t len)
+{
+    mem->len   = round16k(len);
+    mem->start = -1;
+    mem->addr  = NULL;
+    if (sceKernelMapFlexibleMemory(&mem->addr, mem->len, PROT_CPU_RW, 0) != 0)
+        return AVERROR(ENOMEM);
+    return 0;
+}
+
+/**
+ * The decoder's working memory. Flexible memory that is given back does not
+ * come back to the pool on this console, so one block is kept and reused.
+ */
+static pthread_mutex_t g_cpuBlockLock = PTHREAD_MUTEX_INITIALIZER;
+static void*           g_cpuBlock     = NULL;
+static size_t          g_cpuBlockLen  = 0;
+static int             g_cpuBlockBusy  = 0;
+
+static int memCpu(Mem* mem, size_t len)
+{
+    len = round16k(len);
+    pthread_mutex_lock(&g_cpuBlockLock);
+    if (!g_cpuBlockBusy) {
+        if (len > g_cpuBlockLen) {
+            // Room for 4K HEVC's 76 MiB, so the block rarely has to grow.
+            size_t want = len > ((size_t)96 << 20) ? len : ((size_t)96 << 20);
+            void* addr   = NULL;
+            // The decoder finds its workspace by name, so it has to be a
+            // named piece of memory.
+            if (sceKernelMapNamedFlexibleMemory(&addr, want, PROT_CPU_RW, 0, "ffmpeg-vdec") == 0) {
+                g_cpuBlock     = addr;
+                g_cpuBlockLen  = want;
+            }
+        }
+        if (g_cpuBlock && len <= g_cpuBlockLen) {
+            g_cpuBlockBusy = 1;
+            mem->addr      = g_cpuBlock;
+            mem->len       = len;
+            mem->start     = -2;
+            pthread_mutex_unlock(&g_cpuBlockLock);
+            return 0;
+        }
+    }
+    pthread_mutex_unlock(&g_cpuBlockLock);
+    return memFlexible(mem, len);
+}
+
+static void memFree(Mem* mem)
+{
+    if (!mem->addr)
+        return;
+    if (mem->start == -2) {
+        pthread_mutex_lock(&g_cpuBlockLock);
+        g_cpuBlockBusy = 0;
+        pthread_mutex_unlock(&g_cpuBlockLock);
+    } else if (mem->start >= 0) {
+        sceKernelMunmap(mem->addr, mem->len);
+        sceKernelReleaseDirectMemory(mem->start, mem->len);
+    } else {
+        sceKernelMunmap(mem->addr, mem->len);
+    }
+    mem->addr  = NULL;
+    mem->len   = 0;
+    mem->start = -1;
+}
+
+/**
+ * The queue the application made. The console gives one only: it has to be
+ * made before the application asks for full access, the ones made later are
+ * refused. The application that plays the video makes it on startup and
+ * gives it to the decoder.
+ */
+extern void* wiliwili_ps5_compute_queue(void) __attribute__((weak));
+
+/**
+ * The compute queue the decoders run on. One for the life of the process: it
+ * has to be made before the application asks for full access, the decoders
+ * made later are refused.
+ */
+static pthread_mutex_t g_queueLock = PTHREAD_MUTEX_INITIALIZER;
+static void*           g_queue     = NULL;
+static Mem             g_queueMem;
+
+static void* computeQueue(void)
+{
+    if (wiliwili_ps5_compute_queue)
+        return wiliwili_ps5_compute_queue();
+
+    pthread_mutex_lock(&g_queueLock);
+    if (!g_queue) {
+        VdecComputeMemory info = {.this_size = sizeof(info)};
+        int rc                = sceVideodec2QueryComputeMemoryInfo(&info);
+        if (rc == 0 && memDirect(&g_queueMem, info.cpu_gpu_memory_size, PAGE_16K,
+                                 PROT_CPU_RW | PROT_GPU_RW) == 0) {
+            info.cpu_gpu_memory      = g_queueMem.addr;
+            info.cpu_gpu_memory_size = g_queueMem.len;
+            VdecComputeConfig config = {.this_size = sizeof(config)};
+            rc                       = sceVideodec2AllocateComputeQueue(&config, &info, &g_queue);
+            if (rc != 0) {
+                g_queue = NULL;
+                memFree(&g_queueMem);
+            }
+        }
+    }
+    void* queue = g_queue;
+    pthread_mutex_unlock(&g_queueLock);
+    return queue;
+}
+
+#define MAX_PENDING 64
+
+/**
+ * The decoder of one stream: the chip's decoder and the memory it works in.
+ */
+typedef struct Ps5Context
+{
+    AVClass* class;
+
+    void* decoder;
+    int    codec;
+    int    profile;
+    int    level;
+    int    tenBit;
+    int    draining;
+    int    failed;
+    // The room the chip was given for the picture.
+    int    roomWidth;
+    int    roomHeight;
+    int    roomLevel;
+    // Whether the first picture has been looked at.
+    int    measured;
+    // The pictures that follow a random access point and are not
+    // decodable on their own are left out.
+    int    dropLeading;
+    // How many access units went in without a picture coming out.
+    int    silent;
+
+    unsigned frameCount;
+    size_t   frameSize;
+    unsigned nextSlot;
+    unsigned nextAu;
+    unsigned lastSlot;
+    // The slots the chip still holds a picture in: handing one of those out
+    // again is refused.
+    bool     held[32];
+    Mem      frames;
+    Mem      cpu;
+    Mem      gpu;
+    Mem      cpuGpu;
+    Mem      au[AU_SLOTS];
+
+    // The times of the pictures that were sent but have not come out yet.
+    // The chip shows the pictures in the order they are to be seen, so the
+    // smallest time waiting is the picture that comes out.
+    int64_t  pending[MAX_PENDING];
+    int      pendingCount;
+
+    // The parameter sets, in Annex B, in front of every picture.
+    uint8_t* headers;
+    size_t   headersSize;
+
+    // The picture that came out of the chip and is waiting to be handed on.
+    VdecOutput picture;
+    int        hasPicture;
+
+    AVPacket* pkt;
+} Ps5Context;
+
+/**
+ * A picture buffer from the decoder's own store that the chip does not hold
+ * a picture in yet. The chip writes the decoded picture there; without one it
+ * has nowhere to put it, and it refuses the work.
+ */
+static VdecFrameBuffer nextFrameBuffer(Ps5Context* ps5)
+{
+    VdecFrameBuffer fb = {.this_size = sizeof(fb)};
+    if (!ps5->frames.addr || ps5->frameSize == 0)
+        return fb;
+    unsigned slot = ps5->frameCount;
+    for (unsigned i = 0; i < ps5->frameCount; i++) {
+        unsigned index = (ps5->nextSlot + i) % ps5->frameCount;
+        if (!ps5->held[index]) {
+            slot         = index;
+            ps5->nextSlot = index + 1;
+            break;
+        }
+    }
+    if (slot == ps5->frameCount)
+        return fb;
+    ps5->lastSlot            = slot;
+    fb.frame_buffer          = (uint8_t*)ps5->frames.addr + slot * ps5->frameSize;
+    fb.frame_buffer_size     = ps5->frameSize;
+    return fb;
+}
+
+/// The slot the chip took a picture in is free again once it was copied out.
+static void releaseFrameBuffer(Ps5Context* ps5, bool accepted)
+{
+    if (accepted && ps5->lastSlot < ps5->frameCount)
+        ps5->held[ps5->lastSlot] = false;
+}
+
+/// The slot a picture came out of, when it is one of ours.
+static int frameSlotOf(Ps5Context* ps5, const void* buffer)
+{
+    if (!ps5->frames.addr || !buffer)
+        return -1;
+    const uint8_t* base = (const uint8_t*)ps5->frames.addr;
+    if ((const uint8_t*)buffer < base)
+        return -1;
+    size_t offset = (size_t)((const uint8_t*)buffer - base);
+    if (offset % ps5->frameSize)
+        return -1;
+    size_t slot = offset / ps5->frameSize;
+    if (slot >= ps5->frameCount)
+        return -1;
+    return (int)slot;
+}
+
+/**
+ * Starts the chip's decoder for one stream.
+ */
+static int startDecoder(Ps5Context* ps5, int codec, int profile, int level, int width, int height)
+{
+    void* queue = computeQueue();
+    if (!queue)
+        return AVERROR(ENOSYS);
+
+    VdecConfig config = {
+        .this_size                 = sizeof(config),
+        .resource_type             = 1,
+        .codec_type                = codec == VDEC_CODEC_AVC ? VDEC_CODEC_AVC : VDEC_CODEC_HEVC,
+        .profile                   = (uint32_t)profile,
+        .max_level                 = (uint32_t)level,
+        // The size of the picture, rounded to the block the encoder codes
+        // with: it may be up to 64, and a room that is a little too small
+        // makes the chip refuse every picture.
+        .max_frame_width           = width ? (int32_t)((width + 63) & ~63) : 3840,
+        .max_frame_height          = height ? (int32_t)((height + 63) & ~63) : 2176,
+        // The decoder's picture store: the decoder sizes it itself.
+        .max_dpb_frame_count       = -1,
+        // Four pictures in flight: the pipeline of one costs throughput, and
+        // the console refuses the decoder when the memory does not fit.
+        .decode_pipeline_depth     = 4,
+        .compute_queue             = queue,
+        .cpu_affinity_mask         = 0x3f,
+        .cpu_thread_priority       = 700,
+        .optimize_progressive_video = true,
+    };
+    ps5->frameCount = 10;
+
+    int bringUp = -1;
+    for (int attempt = 0; attempt < 3; attempt++) {
+        VdecMemory mem = {.this_size = sizeof(mem)};
+        int queryRc = sceVideodec2QueryDecoderMemoryInfo(&config, &mem);
+        if (queryRc != 0) {
+            av_log(ps5, AV_LOG_ERROR, "The console's video decoder: memory query failed\n");
+            fprintf(stderr,
+                    "[wiliwili] the console's decoder: no memory for %s profile %d, level %d, %dx%d: "
+                    "0x%08x\n",
+                    codec == VDEC_CODEC_AVC ? "H.264" : "HEVC", profile, level, config.max_frame_width,
+                    config.max_frame_height, (unsigned)queryRc);
+            return AVERROR_EXTERNAL;
+        }
+        size_t alignment = mem.frame_buffer_alignment > PAGE_16K ? mem.frame_buffer_alignment : PAGE_16K;
+        ps5->frameSize  = (mem.max_frame_buffer_size + alignment - 1) & ~(alignment - 1);
+
+        int ok = (!mem.cpu_memory_size || memCpu(&ps5->cpu, mem.cpu_memory_size) == 0) &&
+                 (!mem.gpu_memory_size ||
+                  memDirect(&ps5->gpu, mem.gpu_memory_size, PAGE_16K, PROT_CHIP_POOL) == 0) &&
+                 (!mem.cpu_gpu_memory_size ||
+                  memDirect(&ps5->cpuGpu, mem.cpu_gpu_memory_size, PAGE_16K, PROT_CPU_RW | PROT_GPU_RW) ==
+                      0) &&
+                 memDirect(&ps5->frames, ps5->frameSize * ps5->frameCount, alignment,
+                           PROT_CHIP_POOL) == 0;
+        for (int i = 0; ok && i < AU_SLOTS; i++)
+            ok = memDirect(&ps5->au[i], AU_SLOT_SIZE, PAGE_16K, PROT_CHIP_POOL) == 0;
+        if (ok) {
+            // The memory is new to the chip: a picture it did not decode fully
+            // would show what was there before.
+            if (ps5->cpu.addr)
+                memset(ps5->cpu.addr, 0, ps5->cpu.len);
+            if (ps5->gpu.addr)
+                memset(ps5->gpu.addr, 0, ps5->gpu.len);
+            if (ps5->cpuGpu.addr)
+                memset(ps5->cpuGpu.addr, 0, ps5->cpuGpu.len);
+            if (ps5->tenBit) {
+                uint64_t* words = (uint64_t*)ps5->frames.addr;
+                for (size_t i = 0, n = ps5->frames.len / 8; i < n; i++)
+                    words[i] = 0x0200020002000200ull;
+            } else {
+                memset(ps5->frames.addr, 0x80, ps5->frames.len);
+            }
+            mem.cpu_memory             = ps5->cpu.addr;
+            mem.gpu_memory             = ps5->gpu.addr;
+            mem.cpu_gpu_memory         = ps5->cpuGpu.addr;
+            // The sizes the chip asked for, rounded up as it wants them.
+            mem.gpu_memory_size        = ps5->gpu.len;
+            mem.cpu_gpu_memory_size    = ps5->cpuGpu.len;
+            mem.max_frame_buffer_size  = ps5->frameSize;
+            mem.frame_buffer_alignment = (uint32_t)alignment;
+            void* decoder               = NULL;
+            int createRc = sceVideodec2CreateDecoder(&config, &mem, &decoder);
+            if (createRc == 0) {
+                // The decoder only starts to work after it has been reset.
+                int resetRc = sceVideodec2Reset(decoder);
+                if (resetRc == 0) {
+                    ps5->decoder = decoder;
+                    bringUp     = 0;
+                } else {
+                    fprintf(stderr, "[wiliwili] the console's decoder: the reset failed: 0x%08x\n",
+                            (unsigned)resetRc);
+                    sceVideodec2DeleteDecoder(decoder);
+                }
+            } else {
+                fprintf(stderr,
+                        "[wiliwili] the console's decoder: %s profile %d, level %d, %dx%d was refused: "
+                        "0x%08x\n",
+                        codec == VDEC_CODEC_AVC ? "H.264" : "HEVC", profile, level, config.max_frame_width,
+                        config.max_frame_height, (unsigned)createRc);
+            }
+        }
+        if (bringUp == 0)
+            break;
+
+        // The memory that was asked for is given back.
+        for (int i = 0; i < AU_SLOTS; i++)
+            memFree(&ps5->au[i]);
+        memFree(&ps5->frames);
+        memFree(&ps5->cpuGpu);
+        memFree(&ps5->gpu);
+        memFree(&ps5->cpu);
+
+        // The chip refuses a decoder that does not fit the stream: a
+        // picture that is bigger than 1080p gets room for 4K instead, and
+        // the level goes with the room.
+        if (attempt == 0) {
+            config.max_frame_width  = 3840;
+            config.max_frame_height = 2176;
+            config.max_level        = codec == VDEC_CODEC_AVC ? 52 : 153;
+            continue;
+        }
+        if (attempt == 1) {
+            // Four pictures in the store and one at a time: the values that
+            // need the least memory.
+            config.max_dpb_frame_count   = 4;
+            config.decode_pipeline_depth = 1;
+            continue;
+        }
+        av_log(ps5, AV_LOG_ERROR, "The console's video decoder: no memory for the decoder\n");
+        return AVERROR(ENOMEM);
+    }
+
+    ps5->codec        = codec;
+    ps5->profile      = profile;
+    ps5->level        = level;
+    ps5->dropLeading  = 1;
+    ps5->roomWidth    = config.max_frame_width;
+    ps5->roomHeight   = config.max_frame_height;
+    ps5->roomLevel    = (int)config.max_level;
+    av_log(ps5, AV_LOG_INFO, "The console's video decoder is ready (%s %dx%d, %u pictures of %zu KiB)\n",
+           codec == VDEC_CODEC_AVC ? "H.264" : "HEVC", config.max_frame_width, config.max_frame_height,
+           ps5->frameCount, ps5->frameSize >> 10);
+    fprintf(stderr, "[wiliwili] the console's decoder is ready: %s %dx%d, %u pictures of %zu KiB\n",
+            codec == VDEC_CODEC_AVC ? "H.264" : "HEVC", config.max_frame_width, config.max_frame_height,
+            ps5->frameCount, ps5->frameSize >> 10);
+    return 0;
+}
+
+static void stopDecoder(Ps5Context* ps5)
+{
+    if (ps5->decoder) {
+        sceVideodec2DeleteDecoder(ps5->decoder);
+        ps5->decoder = NULL;
+    }
+    for (int i = 0; i < AU_SLOTS; i++)
+        memFree(&ps5->au[i]);
+    memFree(&ps5->frames);
+    memFree(&ps5->cpuGpu);
+    memFree(&ps5->gpu);
+    memFree(&ps5->cpu);
+}
+
+/**
+ * The parameter sets of the stream, in Annex B. The chip wants them in
+ * front of every picture.
+ */
+static int readHeaders(Ps5Context* ps5, const uint8_t* data, int size)
+{
+    if (size <= 0)
+        return 0;
+
+    // The bitstream filter leaves the data in Annex B already.
+    av_freep(&ps5->headers);
+    ps5->headers = av_malloc(size);
+    if (!ps5->headers)
+        return AVERROR(ENOMEM);
+    memcpy(ps5->headers, data, size);
+    ps5->headersSize = size;
+    return 0;
+}
+
+/**
+ * The parameter set of the given kind in a stream that is in Annex B.
+ *
+ * The chip counts the pictures the way the codecs do, and it wants to know
+ * what the stream is before it decodes it: the profile and the level of the
+ * parameter set are what it asks for.
+ */
+static const uint8_t* findParameterSet(const uint8_t* data, int size, int type, int hevc)
+{
+    if (!data || size <= 0)
+        return NULL;
+
+    int i = 0;
+    while (i + 3 <= size) {
+        int start = -1;
+        if (i + 4 <= size && data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 0 && data[i + 3] == 1)
+            start = i + 4;
+        else if (data[i] == 0 && data[i + 1] == 0 && data[i + 2] == 1)
+            start = i + 3;
+        if (start < 0 || start >= size)
+            break;
+
+        int nalType = hevc ? ((data[start] >> 1) & 0x3f) : (data[start] & 0x1f);
+        if (nalType == type)
+            return data + start;
+
+        i = start;
+    }
+    return NULL;
+}
+
+/**
+ * The profile of the stream, from its sequence parameter set.
+ *
+ * The decoder is asked for the parameters of the stream before a single
+ * picture is decoded, and the fields of the context are still empty at that
+ * time: the profile is only in the parameter set.
+ */
+static int streamProfile(int codec, const uint8_t* annexb, int size)
+{
+    int hevc   = codec == VDEC_CODEC_HEVC;
+    int spsType = hevc ? 33 : 7;
+
+    const uint8_t* sps = findParameterSet(annexb, size, spsType, hevc);
+    if (!sps)
+        return 0;
+
+    // The parameter set begins with the header of the unit: one byte for
+    // H.264, two for HEVC.
+    const uint8_t* payload = sps + (hevc ? 2 : 1);
+    if (hevc) {
+        // general_profile_space, general_tier_flag, general_profile_idc
+        if (payload + 2 > annexb + size)
+            return 0;
+        return payload[1] & 0x1f;
+    }
+    // profile_idc
+    if (payload + 1 > annexb + size)
+        return 0;
+    return payload[0];
+}
+
+/**
+ * The size and the level of the picture of the stream.
+ *
+ * The decoder is asked for them before a single picture is decoded, and the
+ * fields of the context are still empty at that time: the first picture says
+ * how big it is, and the parser of the codec reads it out of the parameter
+ * sets and the picture itself.
+ */
+static int measureStream(Ps5Context* ps5, const AVPacket* pkt, int* width, int* height, int* level)
+{
+    enum AVCodecID id = ps5->codec == VDEC_CODEC_HEVC ? AV_CODEC_ID_HEVC : AV_CODEC_ID_H264;
+
+    AVCodecContext* tmp = avcodec_alloc_context3(NULL);
+    if (!tmp)
+        return 0;
+    AVCodecParserContext* parser = av_parser_init(id);
+    if (!parser) {
+        avcodec_free_context(&tmp);
+        return 0;
+    }
+
+    uint8_t* data = NULL;
+    int     size = 0;
+
+    // The parameter sets of the stream first, then the picture: the parser
+    // needs the sets to read the picture.
+    if (ps5->headersSize) {
+        size = (int)ps5->headersSize;
+        av_parser_parse2(parser, tmp, &data, &size, ps5->headers, size, 0, 0, 0);
+    }
+    size = pkt->size;
+    av_parser_parse2(parser, tmp, &data, &size, pkt->data, size, 0, 0, 0);
+
+    int ok = 0;
+    if (tmp->width > 0 && tmp->height > 0) {
+        *width  = tmp->width;
+        *height = tmp->height;
+        if (tmp->level > 0)
+            *level = tmp->level;
+        ok = 1;
+    }
+
+    av_parser_close(parser);
+    avcodec_free_context(&tmp);
+    return ok;
+}
+
+/**
+ * The units of an access unit, and the ones the chip is given.
+ *
+ * The chip refuses a key picture whose unit holds the same parameter set
+ * twice: the bitstream filter puts the container's sets in front of every key
+ * picture, and the stream carries its own in band, so the same set is in the
+ * unit twice - and the key picture is refused, and with it every picture that
+ * comes after it. The copy that is nearest the picture is the one the stream
+ * means, so the earlier one is left out.
+ *
+ * The units of type 48 and up are left out as well: they are the extension
+ * layers (Dolby Vision among them), and the console reads the base layer only.
+ *
+ * Returns the number of bytes written, or -1 when the unit is not in Annex B
+ * (the caller then hands it over as it is).
+ */
+#define VDEC_MAX_UNITS 512
+
+static int cleanAccessUnit(uint8_t* dst, const uint8_t* au, int size, int hevc)
+{
+    int startAt[VDEC_MAX_UNITS];
+    int unitAt[VDEC_MAX_UNITS];
+    int endAt[VDEC_MAX_UNITS];
+    int count = 0;
+
+    // The units of the parameter sets, by type: HEVC 32/33/34, H.264 7/8.
+    int first = -1;
+    for (int i = 0; i + 3 <= size; i++) {
+        if (au[i] == 0 && au[i + 1] == 0 && au[i + 2] == 1) {
+            first = (i > 0 && au[i - 1] == 0) ? i - 1 : i;
+            break;
+        }
+    }
+    if (first < 0)
+        return -1;
+
+    int sc = first;
+    int unit = first + 3;
+    while (unit < size && count < VDEC_MAX_UNITS) {
+        int nextSc = size;
+        int nextUnit = -1;
+        for (int j = unit; j + 3 <= size; j++) {
+            if (au[j] == 0 && au[j + 1] == 0 && au[j + 2] == 1) {
+                nextSc   = (j > unit && au[j - 1] == 0) ? j - 1 : j;
+                nextUnit = j + 3;
+                break;
+            }
+        }
+        startAt[count] = sc;
+        unitAt[count]  = unit;
+        endAt[count]   = nextSc;
+        count++;
+        if (nextUnit < 0)
+            break;
+        sc   = nextSc;
+        unit = nextUnit;
+    }
+    if (count == VDEC_MAX_UNITS && unit < size) {
+        // Too many units to look at: the unit goes over as it is.
+        return -1;
+    }
+
+    int out = 0;
+    for (int k = 0; k < count; k++) {
+        const uint8_t* header = au + unitAt[k];
+        int type = hevc ? ((header[0] >> 1) & 0x3f) : (header[0] & 0x1f);
+        if (hevc && type >= 48)
+            continue;
+        if (!hevc && (type == 7 || type == 8)) {
+            // The same set again further down the unit: the copy nearest the
+            // picture is the one that counts.
+            int later = 0;
+            for (int m = k + 1; m < count && !later; m++) {
+                const uint8_t* other = au + unitAt[m];
+                int otherType = other[0] & 0x1f;
+                later = otherType == type && (int)(endAt[m] - unitAt[m]) == (int)(endAt[k] - unitAt[k]) &&
+                        !memcmp(au + unitAt[k], au + unitAt[m], (size_t)(endAt[k] - unitAt[k]));
+            }
+            if (later)
+                continue;
+        } else if (hevc && (type == 32 || type == 33 || type == 34)) {
+            int later = 0;
+            for (int m = k + 1; m < count && !later; m++) {
+                const uint8_t* other = au + unitAt[m];
+                int otherType = (other[0] >> 1) & 0x3f;
+                later = otherType == type && (int)(endAt[m] - unitAt[m]) == (int)(endAt[k] - unitAt[k]) &&
+                        !memcmp(au + unitAt[k], au + unitAt[m], (size_t)(endAt[k] - unitAt[k]));
+            }
+            if (later)
+                continue;
+        }
+        memcpy(dst + out, au + startAt[k], (size_t)(endAt[k] - startAt[k]));
+        out += endAt[k] - startAt[k];
+    }
+    return out;
+}
+
+/**
+ * The kind of the first picture of an access unit: the type of its first
+ * slice unit, or -1 when it has none.
+ *
+ * HEVC numbers its units: 0 to 31 are the pictures, 8 and 9 are the ones
+ * that follow a random access point and whose references come before it,
+ * 16 to 23 are the random access points themselves.
+ */
+static int accessUnitType(const uint8_t* au, int size)
+{
+    for (int i = 0; i + 4 < size; i++) {
+        if (au[i] != 0 || au[i + 1] != 0)
+            continue;
+        int payload;
+        if (au[i + 2] == 1)
+            payload = i + 3;
+        else if (au[i + 2] == 0 && au[i + 3] == 1)
+            payload = i + 4;
+        else
+            continue;
+        if (payload >= size)
+            break;
+        int type = (au[payload] >> 1) & 0x3f;
+        if (type <= 31)
+            return type;
+        i = payload;
+    }
+    return -1;
+}
+
+/**
+ * The access unit the chip reads: the parameter sets and the packet.
+ */
+static int buildAccessUnit(Ps5Context* ps5, const AVPacket* pkt, uint8_t** out, size_t* outSize){
+    size_t headers = ps5->headersSize;
+    size_t total   = headers + (size_t)pkt->size;
+    if (total > AU_SLOT_SIZE)
+        return AVERROR_INVALIDDATA;
+
+    uint8_t* au = av_malloc(total ? total : 1);
+    if (!au)
+        return AVERROR(ENOMEM);
+    if (headers)
+        memcpy(au, ps5->headers, headers);
+    if (pkt->size)
+        memcpy(au + headers, pkt->data, pkt->size);
+
+    // The chip wants one copy of every parameter set: the unit that the
+    // bitstream filter and the packet together made can hold the same set
+    // twice, and the chip refuses such a key picture.
+    size_t size = total;
+    if (ps5->codec == VDEC_CODEC_HEVC && total > 0) {
+        uint8_t* clean = av_malloc(total);
+        if (clean) {
+            int written = cleanAccessUnit(clean, au, (int)total, 1);
+            if (written > 0) {
+                memcpy(au, clean, (size_t)written);
+                size = (size_t)written;
+            }
+            av_free(clean);
+        }
+    }
+
+    *out     = au;
+    *outSize = size;
+    return 0;
+}
+
+/**
+ * The time of the picture that comes out: the smallest one that is waiting.
+ */
+static int64_t takePending(Ps5Context* ps5)
+{
+    if (!ps5->pendingCount)
+        return AV_NOPTS_VALUE;
+    int best = 0;
+    for (int i = 1; i < ps5->pendingCount; i++)
+        if (ps5->pending[i] < ps5->pending[best])
+            best = i;
+    int64_t pts = ps5->pending[best];
+    ps5->pending[best] = ps5->pending[--ps5->pendingCount];
+    return pts;
+}
+
+static void addPending(Ps5Context* ps5, int64_t pts)
+{
+    if (ps5->pendingCount >= MAX_PENDING) {
+        memmove(ps5->pending, ps5->pending + 1, (MAX_PENDING - 1) * sizeof(ps5->pending[0]));
+        ps5->pendingCount--;
+    }
+    ps5->pending[ps5->pendingCount++] = pts;
+}
+
+/**
+ * Hands the picture the chip produced to the caller.
+ */
+static int outputPicture(AVCodecContext* avctx, AVFrame* frame, const VdecOutput* out, int64_t pts)
+{
+    Ps5Context* ps5 = avctx->priv_data;
+
+    if (out->is_error_frame || !out->frame_buffer || !out->frame_width || !out->frame_height) {
+        av_log(avctx, AV_LOG_WARNING, "The console's video decoder: the picture is not there\n");
+        return AVERROR_INVALIDDATA;
+    }
+
+    size_t pitch   = out->frame_pitch_in_bytes ? out->frame_pitch_in_bytes : out->frame_width;
+    size_t luma    = pitch * out->frame_height;
+    size_t chroma  = pitch * (out->frame_height / 2);
+    size_t needed  = luma + chroma;
+
+    frame->format      = ps5->tenBit ? AV_PIX_FMT_P010 : AV_PIX_FMT_NV12;
+    frame->width       = out->frame_width;
+    frame->height      = out->frame_height;
+    frame->pts         = pts;
+    frame->color_range = AVCOL_RANGE_MPEG;
+
+    AVBufferRef* buf = av_buffer_alloc(needed);
+    if (!buf)
+        return AVERROR(ENOMEM);
+    frame->buf[0] = buf;
+    frame->data[0] = buf->data;
+    frame->linesize[0] = (int)pitch;
+    frame->data[1]     = buf->data + luma;
+    frame->linesize[1] = (int)pitch;
+
+    memcpy(frame->data[0], out->frame_buffer, luma);
+    memcpy(frame->data[1], (const uint8_t*)out->frame_buffer + luma, chroma);
+    return 0;
+}
+
+/**
+ * Gives one access unit to the chip. The picture it produced, if any, comes
+ * back in out.
+ */
+static int decodeAccessUnit(Ps5Context* ps5, const uint8_t* au, size_t size, int64_t pts,
+                             VdecOutput* out)
+{
+    // The chip reads the access unit from the graphics memory. The slots are
+    // used in turn: the chip reads them before the next call.
+    Mem* slot = &ps5->au[ps5->nextAu % AU_SLOTS];
+    ps5->nextAu++;
+    memcpy(slot->addr, au, size);
+
+    VdecInput in = {
+        .this_size = sizeof(in),
+        .au_data   = slot->addr,
+        .au_size   = size,
+        .pts_data  = (uint64_t)pts,
+        .dts_data  = UINT64_MAX,
+    };
+    VdecFrameBuffer fb = nextFrameBuffer(ps5);
+    memset(out, 0, sizeof(*out));
+    out->this_size = sizeof(*out);
+
+    int rc = 0;
+    PS5_RUN_GUARDED(rc = sceVideodec2Decode(ps5->decoder, &in, &fb, out), rc);
+    {
+        // The console's decoder says what it did with the access unit: the
+        // first ones and every picture that comes out.
+        static long calls = 0;
+        if (++calls <= 6 || out->is_valid || rc != 0) {
+            fprintf(stderr,
+                    "[wiliwili] the console's decoder: decode #%ld rc=0x%08x accepted=%d valid=%d error=%d "
+                    "pictures=%d %dx%d\n",
+                    calls, (unsigned)rc, (int)fb.is_accepted, (int)out->is_valid, (int)out->is_error_frame,
+                    (int)out->picture_count, (int)out->frame_width, (int)out->frame_height);
+        }
+    }
+    if (rc != 0) {
+        releaseFrameBuffer(ps5, fb.is_accepted);
+        return AVERROR_EXTERNAL;
+    }
+    if (fb.is_accepted && ps5->lastSlot < ps5->frameCount)
+        ps5->held[ps5->lastSlot] = true;
+    // The time of the picture waits until the picture comes out.
+    addPending(ps5, pts);
+    return 0;
+}
+
+/**
+ * Takes the pictures that are still inside the chip.
+ */
+static int drainDecoder(Ps5Context* ps5, VdecOutput* out)
+{
+    VdecFrameBuffer fb = nextFrameBuffer(ps5);
+    memset(out, 0, sizeof(*out));
+    out->this_size = sizeof(*out);
+
+    int rc = 0;
+    PS5_RUN_GUARDED(rc = sceVideodec2Flush(ps5->decoder, &fb, out), rc);
+    if (rc != 0) {
+        releaseFrameBuffer(ps5, fb.is_accepted);
+        return AVERROR_EXTERNAL;
+    }
+    if (fb.is_accepted && ps5->lastSlot < ps5->frameCount)
+        ps5->held[ps5->lastSlot] = true;
+    // The pictures that were in the chip are gone: the times that waited for
+    // them are of no use, and the slots they held are free again. The player
+    // seeks, and the pictures after the seek may be of the kind that cannot
+    // be decoded on their own.
+    ps5->pendingCount = 0;
+    ps5->dropLeading  = 1;
+    memset(ps5->held, 0, sizeof(ps5->held));
+    return out->is_valid ? 0 : AVERROR_EOF;
+}
+
+/**
+ * The pictures the chip has ready are handed on one at a time.
+ *
+ * The chip shows the pictures in the order they are to be seen, one access
+ * unit after the other: the picture of an access unit comes out when the
+ * next one is given to the chip. The times of the pictures that were sent
+ * but have not come out yet are kept, and the picture that comes out is given
+ * the smallest of them.
+ */
+static int ps5_receive_frame(AVCodecContext* avctx, AVFrame* frame)
+{
+    Ps5Context* ps5 = avctx->priv_data;
+
+    if (ps5->failed)
+        return AVERROR_EXTERNAL;
+
+    for (;;) {
+        // A picture that came out with the last access unit.
+        if (ps5->hasPicture) {
+            ps5->hasPicture = 0;
+            int64_t pts = takePending(ps5);
+            int    slot = frameSlotOf(ps5, ps5->picture.frame_buffer);
+            int    ret  = outputPicture(avctx, frame, &ps5->picture, pts);
+            if (slot >= 0)
+                ps5->held[slot] = false;
+            if (ret < 0)
+                return ret;
+            return 0;
+        }
+
+        if (!ps5->draining) {
+            // Another access unit for the chip.
+            AVPacket* pkt = ps5->pkt;
+            int       ret = ff_decode_get_packet(avctx, pkt);
+            if (ret == AVERROR_EOF) {
+                ps5->draining = 1;
+                continue;
+            }
+            if (ret < 0)
+                return ret;
+            if (!pkt->size) {
+                av_packet_unref(pkt);
+                continue;
+            }
+            // A picture comes again: the chip works again after the flush.
+            // The player seeks when the video starts, and the flush must not
+            // end the decoding for good.
+            ps5->draining = 0;
+
+            // The chip needs the room for the picture before it decodes it,
+            // and the size of the picture is only known once it is there: the
+            // first picture measures the stream, and the chip is asked again
+            // when the room is too small.
+            if (!ps5->measured) {
+                ps5->measured = 1;
+                int width = 0, height = 0, level = 0;
+                if (measureStream(ps5, pkt, &width, &height, &level)) {
+                    fprintf(stderr, "[wiliwili] the console's decoder: the picture is %dx%d, level %d\n",
+                            width, height, level);
+                    if (width > ps5->roomWidth || height > ps5->roomHeight) {
+                        // The room the chip gets goes with the picture: the
+                        // level of the chip counts like the level of the
+                        // codec, and a 4K picture wants 5.1 (HEVC) or 5.2
+                        // (H.264).
+                        int want = ps5->codec == VDEC_CODEC_HEVC
+                                       ? (height > 1440 ? 153 : (height > 1080 ? 150 : 123))
+                                       : (height > 1440 ? 52 : 51);
+                        if (level > want)
+                            want = level;
+                        fprintf(stderr,
+                                "[wiliwili] the console's decoder: the room grows from %dx%d to %dx%d, level %d\n",
+                                ps5->roomWidth, ps5->roomHeight, width, height, want);
+                        stopDecoder(ps5);
+                        int again = startDecoder(ps5, ps5->codec, ps5->profile, want, width, height);
+                        if (again < 0) {
+                            av_packet_unref(pkt);
+                            ps5->failed = 1;
+                            return again;
+                        }
+                    }
+                }
+            }
+
+            uint8_t* au     = NULL;
+            size_t   auSize = 0;
+            ret             = buildAccessUnit(ps5, pkt, &au, &auSize);
+            if (ret == 0 && ps5->codec == VDEC_CODEC_HEVC && ps5->dropLeading) {
+                // The pictures that follow a random access point and whose
+                // references come before it cannot be decoded: the chip is
+                // given the ones that can.
+                int type = accessUnitType(au, (int)auSize);
+                if (type == 8 || type == 9) {
+                    av_freep(&au);
+                    av_packet_unref(pkt);
+                    continue;
+                }
+                if (type >= 0 && type <= 5)
+                    ps5->dropLeading = 0;
+            }
+            if (ret < 0) {
+                av_packet_unref(pkt);
+                return ret;
+            }
+            VdecOutput out;
+            ret = decodeAccessUnit(ps5, au, auSize, pkt->pts, &out);
+            av_freep(&au);
+            av_packet_unref(pkt);
+            if (ret < 0) {
+                ps5->failed = 1;
+                return ret;
+            }
+            if (out.is_valid) {
+                ps5->picture    = out;
+                ps5->hasPicture = 1;
+                ps5->silent     = 0;
+            } else if (++ps5->silent > 32) {
+                // The chip takes the work and gives nothing back: it does
+                // not want this stream. The player has to hear about it.
+                av_log(avctx, AV_LOG_ERROR,
+                       "The console's video decoder gives no pictures\n");
+                ps5->failed = 1;
+                return AVERROR_EXTERNAL;
+            }
+            continue;
+        }
+
+        // The stream is over: the pictures that are still inside the chip are
+        // taken out.
+        VdecOutput out;
+        int        ret = drainDecoder(ps5, &out);
+        if (ret == AVERROR_EOF)
+            return AVERROR_EOF;
+        if (ret < 0)
+            return ret;
+        ps5->picture    = out;
+        ps5->hasPicture = 1;
+    }
+}
+
+static av_cold int ps5_decode_init(AVCodecContext* avctx)
+{
+    Ps5Context* ps5 = avctx->priv_data;
+
+    ps5->pkt = avctx->internal->in_pkt;
+
+    int codec = avctx->codec_id == AV_CODEC_ID_HEVC ? VDEC_CODEC_HEVC : VDEC_CODEC_AVC;
+    // The chip counts the profiles the way the codecs do: 66 is Baseline, 77
+    // is Main and 100 is High for H.264, 1 is Main and 2 is Main 10 for
+    // HEVC. The stream's own profile is the one the chip wants.
+    int profile = codec == VDEC_CODEC_HEVC ? 1 : 100;
+    // The level goes with the size of the picture: H.264 counts by ten and
+    // HEVC by thirty. 1080p wants 5.1 (H.264) or 4.1 (HEVC), 1440p wants
+    // 5.0 (HEVC) and 4K wants 5.2 (H.264) or 5.1 (HEVC).
+    int level = codec == VDEC_CODEC_HEVC ? 123 : 51;
+    int width = 1920, height = 1088;
+    // The bit depth is the stream's own: the chip's profile says nothing
+    // about it.
+    ps5->tenBit = codec == VDEC_CODEC_HEVC && avctx->profile == FF_PROFILE_HEVC_MAIN_10;
+
+    // The bitstream filter turns the parameter sets of the container into
+    // Annex B; the decoder's own extradata is still the one of the
+    // container, and the chip would make nothing of it.
+    const uint8_t* extra   = avctx->extradata;
+    int            extraSize = avctx->extradata_size;
+    if (avctx->internal && avctx->internal->bsf && avctx->internal->bsf->par_out->extradata) {
+        extra     = avctx->internal->bsf->par_out->extradata;
+        extraSize = avctx->internal->bsf->par_out->extradata_size;
+    }
+    if (extraSize > 0)
+        readHeaders(ps5, extra, extraSize);
+
+    // The profile of the stream is in its parameter set: the fields of the
+    // context are still empty, because no picture was decoded yet.
+    int streamProfileValue = streamProfile(codec, extra, extraSize);
+    if (streamProfileValue > 0)
+        profile = streamProfileValue;
+    if (codec == VDEC_CODEC_HEVC && profile == FF_PROFILE_HEVC_MAIN_10)
+        ps5->tenBit = 1;
+
+    // The chip's decoder is not made for threads: one thread does the work.
+    avctx->thread_count = 1;
+
+    fprintf(stderr, "[wiliwili] the console's decoder: %s profile %d, level %d, %dx%d, %s\n",
+            codec == VDEC_CODEC_HEVC ? "HEVC" : "H.264", profile, level, width, height,
+            ps5->tenBit ? "10 bit" : "8 bit");
+    {
+        // The parameter sets that go in front of every picture: their size
+        // and their first bytes say whether the stream gave any.
+        fprintf(stderr, "[wiliwili] the console's decoder: %d bytes of parameter sets:", (int)ps5->headersSize);
+        for (int i = 0; i < 16 && i < (int)ps5->headersSize; i++)
+            fprintf(stderr, " %02x", ps5->headers[i]);
+        fprintf(stderr, "\n");
+    }
+
+    int ret = startDecoder(ps5, codec, profile, level, width, height);
+    if (ret < 0) {
+        av_log(avctx, AV_LOG_ERROR, "The console's video decoder did not start\n");
+        fprintf(stderr, "[wiliwili] the console's decoder did not start\n");
+        return ret;
+    }
+    return 0;
+}
+
+static av_cold int ps5_decode_close(AVCodecContext* avctx)
+{
+    Ps5Context* ps5 = avctx->priv_data;
+    stopDecoder(ps5);
+    av_freep(&ps5->headers);
+    return 0;
+}
+
+/**
+ * The pictures come out as NV12, or as P010 for ten bit.
+ *
+ * The field that says this is the one the framework reads when a decoder
+ * does not answer for itself. The framework writes to it when it does have
+ * an answer, and the field lies in the read only part of the image, so the
+ * decoder must not have one.
+ */
+static const enum AVPixelFormat ps5_pix_fmts[] = { AV_PIX_FMT_NV12, AV_PIX_FMT_P010, AV_PIX_FMT_NONE };
+
+#define PS5_DECODER(dec_id, dec_name, dec_long_name, dec_bsf)                              \
+    static const AVClass dec_name##_class = {                                           \
+        .class_name = #dec_name,                                                         \
+        .item_name  = av_default_item_name,                                              \
+        .version    = LIBAVUTIL_VERSION_INT,                                             \
+    };                                                                                   \
+    const FFCodec ff_##dec_name##_decoder = {                                            \
+        .p.name         = #dec_name,                                                     \
+        FF_DISABLE_DEPRECATION_WARNINGS                                                  \
+        .p.long_name    = dec_long_name,                                                 \
+        .p.type         = AVMEDIA_TYPE_VIDEO,                                            \
+        .p.id           = dec_id,                                                        \
+        .p.pix_fmts     = ps5_pix_fmts,                                                  \
+        .priv_data_size = sizeof(Ps5Context),                                            \
+        .p.priv_class   = &dec_name##_class,                                             \
+        .init           = ps5_decode_init,                                               \
+        .close          = ps5_decode_close,                                              \
+        FF_CODEC_RECEIVE_FRAME_CB(ps5_receive_frame),                                    \
+        .bsfs           = dec_bsf,                                                       \
+        .p.capabilities = AV_CODEC_CAP_DELAY | AV_CODEC_CAP_AVOID_PROBING,               \
+        .caps_internal  = FF_CODEC_CAP_NOT_INIT_THREADSAFE | FF_CODEC_CAP_SETS_FRAME_PROPS, \
+        .p.wrapper_name = "ps5",                                                         \
+        FF_ENABLE_DEPRECATION_WARNINGS                                                   \
+    }
+
+PS5_DECODER(AV_CODEC_ID_H264, h264_ps5, "PS5 H.264 decoder", "h264_mp4toannexb");
+PS5_DECODER(AV_CODEC_ID_HEVC, hevc_ps5, "PS5 HEVC decoder", "hevc_mp4toannexb");
