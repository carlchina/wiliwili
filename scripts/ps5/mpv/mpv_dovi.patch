+// --- Dolby Vision -----------------------------------------------------------
+
+/* The reshaping curves of one frame, packed for a std140 uniform block.
+ * Packing mirrors libplacebo: pivots are normalized by 1/2^bl_bit_depth and
+ * the fixed-point coefficients by 1/2^coef_log2_denom, MMR rows are laid out
+ * six per piece (two per order step) so the shader can copy libplacebo's
+ * dot-product structure verbatim. Dolby Vision always ends in BT.2020-referred
+ * HPE LMS; k_lms2rgb takes it to linear BT.2020 RGB (libplacebo's
+ * dovi_lms2rgb). */
+static void dovi_set_identity_curves(mpv_dovi_metadata *p)
+{
+    for (int c = 0; c < 3; c++) {
+        p->lohi[c][0] = 0.0f;
+        p->lohi[c][1] = 1.0f;
+        p->lohi[c][2] = 0.0f;   /* no curve: the shader passes the signal through */
+        p->lohi[c][3] = 0.0f;
+    }
+    for (int i = 0; i < 6; i++) {
+        for (int k = 0; k < 4; k++)
+            p->piv[i][k] = 1e9f;
+    }
+}
+
+static void dovi_set_color(mpv_dovi_metadata *p, const AVDOVIColorMetadata *c)
+{
+    static const double k_lms2rgb[3][3] = {
+        { 3.06441879, -2.16597676,  0.10155818},
+        {-0.65612108,  1.78554118, -0.12943749},
+        { 0.01736321, -0.04725154,  1.03004253},
+    };
+    double rgb2lms[3][3];
+
+    for (int i = 0; i < 3; i++) {
+        for (int j = 0; j < 3; j++) {
+            p->ycc[i][j] = (float)av_q2d(c->ycc_to_rgb_matrix[i * 3 + j]);
+            rgb2lms[i][j] = av_q2d(c->rgb_to_lms_matrix[i * 3 + j]);
+        }
+        p->ycc[i][3] = 0.0f;
+        p->off[i] = (float)av_q2d(c->ycc_to_rgb_offset[i]);
+    }
+    p->off[3] = 0.0f;
+    /* lms = k_lms2rgb * rgb_to_lms, as libplacebo composes them */
+    for (int i = 0; i < 3; i++) {
+        for (int j = 0; j < 3; j++) {
+            double s = 0.0;
+            for (int k = 0; k < 3; k++)
+                s += k_lms2rgb[i][k] * rgb2lms[k][j];
+            p->lms[i][j] = (float)s;
+        }
+        p->lms[i][3] = 0.0f;
+    }
+}
+
+/* AVDOVIMetadata of the frame being drawn -> shader constants. Everything the
+ * shader needs is copied out; anything it cannot map is reported as "no RPU"
+ * with the struct zeroed. Only the Profile-5 shape (10-bit base layer, no
+ * residual) is supported: that is what Bilibili streams. */
+static void dovi_fill_metadata(mpv_dovi_metadata *p, struct mp_image *img)
+{
+    const AVDOVIMetadata *md;
+    const AVDOVIRpuDataHeader *hdr;
+    const AVDOVIDataMapping *map;
+    const AVDOVIColorMetadata *col;
+
+    memset(p, 0, sizeof(*p));
+    dovi_set_identity_curves(p);
+    if (!img || !img->dovi)
+        return;
+
+    md = (AVDOVIMetadata *)img->dovi->data;
+    hdr = av_dovi_get_header((AVDOVIMetadata *)md);
+    map = av_dovi_get_mapping((AVDOVIMetadata *)md);
+    col = av_dovi_get_color((AVDOVIMetadata *)md);
+    if (hdr->bl_bit_depth != 10 || hdr->disable_residual_flag != 1)
+        return;
+
+    dovi_set_color(p, col);
+
+    const float piv_scale  = 1.0f / (float)(1 << hdr->bl_bit_depth);
+    const float coef_scale = 1.0f / (float)(1ULL << hdr->coef_log2_denom);
+
+    for (int c = 0; c < 3; c++) {
+        const AVDOVIReshapingCurve *cv = &map->curves[c];
+        const int np = cv->num_pivots;
+        if (np < 2 || np > 9)
+            continue;                       /* leave this component unshaped */
+
+        p->lohi[c][0] = piv_scale * cv->pivots[0];
+        p->lohi[c][1] = piv_scale * cv->pivots[np - 1];
+        p->lohi[c][2] = 1.0f;
+
+        /* the inner pivots pick the piece, the ends only clamp */
+        for (int i = 1; i < np - 1; i++)
+            p->piv[c * 2 + (i - 1) / 4][(i - 1) % 4] = piv_scale * cv->pivots[i];
+
+        for (int i = 0; i < np - 1; i++) {
+            float *co = p->coef[c * 8 + i];
+            if (cv->mapping_idc[i] == AV_DOVI_MAPPING_POLYNOMIAL) {
+                const int order = cv->poly_order[i];
+                if (order < 1 || order > 2)
+                    return;
+                for (int k = 0; k < 3; k++)
+                    co[k] = (k <= order)
+                                ? coef_scale * (float)cv->poly_coef[i][k] : 0.0f;
+                co[3] = 0.0f;
+            } else if (cv->mapping_idc[i] == AV_DOVI_MAPPING_MMR) {
+                const int order = cv->mmr_order[i];
+                if (order < 1 || order > 3)
+                    return;
+                /* two rows per order step, six rows reserved per piece, which
+                 * is exactly how libplacebo addresses its mmr array */
+                co[0] = coef_scale * (float)cv->mmr_constant[i];
+                co[1] = (float)(i * 6);
+                co[2] = 0.0f;
+                co[3] = (float)order;
+                for (int j = 0; j < order; j++) {
+                    const float *src = (float *)cv->mmr_coef[i][j];
+                    float *a = p->mmr[c * 48 + i * 6 + j * 2];
+                    float *b = p->mmr[c * 48 + i * 6 + j * 2 + 1];
+                    a[0] = coef_scale * src[0];
+                    a[1] = coef_scale * src[1];
+                    a[2] = coef_scale * src[2];
+                    a[3] = 0.0f;
+                    b[0] = coef_scale * src[3];
+                    b[1] = coef_scale * src[4];
+                    b[2] = coef_scale * src[5];
+                    b[3] = coef_scale * src[6];
+                }
+            }
+        }
+    }
+    p->meta[0] = 1.0f;
+}
